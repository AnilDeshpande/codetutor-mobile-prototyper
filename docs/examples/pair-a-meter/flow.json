{
  "app": "Glucose Companion",
  "platforms": ["android", "ios"],
  "tabs": [
    { "label": "Readings", "screen": "readings", "icon": "list" },
    { "label": "Devices", "screen": "devices", "icon": "bluetooth" }
  ],
  "journeys": [
    { "id": "pair-meter", "title": "Pair a meter",
      "screens": [
        { "id": "devices-empty", "screen": "devices", "state": "empty", "title": "Devices · none paired",
          "elements": [ { "type": "bar", "text": "Devices" },
            { "type": "empty", "title": "No meter paired", "text": "Pair your meter to sync readings.", "action": { "text": "Add device", "key": "add" } } ] },
        { "id": "rationale", "screen": "pairing", "state": "rationale", "title": "Why Bluetooth", "parent": "devices",
          "elements": [ { "type": "bar", "text": "Add device", "back": true, "key": "back" },
            { "type": "image", "text": "meter next to phone" },
            { "type": "text", "text": "We use Bluetooth to find your meter. Keep it within 1 m." },
            { "type": "button", "text": "Continue", "key": "continue" },
            { "type": "button", "text": "Skip for now", "variant": "text", "key": "skip" } ] },
        { "id": "permission", "screen": "pairing", "state": "permission", "title": "Bluetooth permission",
          "note": "iOS: one denial is final; the app can't ask again.",
          "elements": [ { "type": "dialog", "system": true, "title": "Allow Glucose Companion to find nearby devices?", "actions": [ { "text": "Don't allow", "key": "deny" }, { "text": "Allow", "key": "allow" } ] } ] },
        { "id": "scan", "screen": "pairing", "state": "scanning", "title": "Scanning",
          "elements": [ { "type": "bar", "text": "Add device", "back": true, "key": "back" },
            { "type": "loading", "text": "Looking for meters…" },
            { "type": "list", "items": [ { "text": "Contour Next", "detail": "Signal strong", "key": "pick" } ] } ] },
        { "id": "pairing", "screen": "pairing", "state": "handshake", "title": "Pairing",
          "elements": [ { "type": "bar", "text": "Pairing", "back": true, "key": "back" },
            { "type": "text", "text": "Confirm the code 4821 on your meter." },
            { "type": "button", "text": "Cancel", "variant": "secondary", "key": "cancel" } ] },
        { "id": "paired", "screen": "devices", "state": "content", "title": "Devices · meter paired",
          "elements": [ { "type": "bar", "text": "Devices" },
            { "type": "banner", "text": "Syncing 12 readings…" },
            { "type": "list", "items": [ { "text": "Contour Next", "detail": "Paired just now", "key": "open" } ] },
            { "type": "snackbar", "text": "Meter paired", "action": "Undo" },
            { "type": "fab", "text": "+ Add", "key": "add" } ] },
        { "id": "denied", "screen": "pairing", "state": "denied", "title": "Permission denied", "below": "permission",
          "elements": [ { "type": "bar", "text": "Add device", "back": true },
            { "type": "error", "title": "Bluetooth is off for this app", "text": "Pairing needs it.", "action": { "text": "Try again", "key": "retry" } },
            { "type": "button", "text": "Open settings", "variant": "text", "key": "settings" } ] },
        { "id": "blocked", "screen": "pairing", "state": "blocked", "title": "Permission blocked", "below": "denied",
          "elements": [ { "type": "bar", "text": "Add device", "back": true },
            { "type": "error", "title": "Allow Bluetooth in Settings", "text": "We can't ask again." },
            { "type": "button", "text": "Open settings", "key": "settings" } ] },
        { "id": "not-found", "screen": "pairing", "state": "not-found", "title": "No meter found", "below": "scan",
          "elements": [ { "type": "bar", "text": "Add device", "back": true },
            { "type": "error", "title": "No meter found", "text": "Wake the meter and try again.", "action": { "text": "Scan again", "key": "retry" } } ] },
        { "id": "cancel-confirm", "screen": "pairing", "state": "cancel", "title": "Stop pairing?", "below": "pairing",
          "elements": [ { "type": "dialog", "title": "Stop pairing?", "text": "The meter locks for 60 seconds.", "actions": [ { "text": "Keep pairing", "key": "keep" }, { "text": "Stop", "key": "stop", "variant": "danger" } ] } ] },
        { "id": "locked", "screen": "pairing", "state": "locked", "title": "Meter locked", "below": "cancel-confirm",
          "elements": [ { "type": "bar", "text": "Add device", "back": true },
            { "type": "text", "text": "The meter is locked for 60 s." },
            { "type": "button", "text": "Done", "key": "done" } ] }
      ],
      "flows": [
        { "from": "devices-empty", "key": "add", "to": "rationale", "label": "tap Add device" },
        { "from": "rationale", "key": "continue", "to": "permission", "label": "Continue" },
        { "from": "rationale", "key": "skip", "to": "devices-empty", "label": "Skip" },
        { "from": "permission", "key": "allow", "to": "scan", "label": "Allow" },
        { "from": "permission", "key": "deny", "to": "denied", "label": "Don't allow" },
        { "from": "denied", "key": "retry", "to": "permission", "label": "Try again" },
        { "from": "denied", "key": "settings", "to": "blocked", "label": "denied twice" },
        { "from": "scan", "key": "pick", "to": "pairing", "label": "tap the meter" },
        { "from": "scan", "to": "not-found", "label": "after 30 s" },
        { "from": "not-found", "key": "retry", "to": "scan", "label": "Scan again" },
        { "from": "pairing", "to": "paired", "label": "code confirmed" },
        { "from": "pairing", "key": "cancel", "to": "cancel-confirm", "label": "Cancel" },
        { "from": "cancel-confirm", "key": "keep", "to": "pairing", "label": "Keep pairing" },
        { "from": "cancel-confirm", "key": "stop", "to": "locked", "label": "Stop" },
        { "from": "locked", "key": "done", "to": "devices-empty", "label": "Done" },
        { "from": "paired", "key": "add", "to": "rationale", "label": "add another" },
        { "from": "blocked", "key": "settings", "to": "scan", "label": "allowed in Settings" }
      ] },
    { "id": "sort-readings", "title": "Sort readings",
      "screens": [
        { "id": "readings", "screen": "readings", "state": "content", "title": "Readings",
          "elements": [ { "type": "bar", "text": "Readings" }, { "type": "chips", "items": ["Day", "Week", "Month"], "active": "Week", "key": "sort" },
            { "type": "list", "items": [ { "text": "5.8 mmol/L", "detail": "Before breakfast" }, { "text": "7.2 mmol/L", "detail": "After lunch" } ] },
            { "type": "switch", "text": "Reminders", "on": true } ] },
        { "id": "sort-sheet", "screen": "readings", "state": "sort", "title": "Sort by", "below": "readings",
          "elements": [ { "type": "sheet", "title": "Sort by", "items": [ { "text": "Newest first", "key": "new" }, { "text": "Highest value", "key": "high" } ] } ] }
      ],
      "flows": [
        { "from": "readings", "key": "sort", "to": "sort-sheet", "label": "tap sort" },
        { "from": "sort-sheet", "key": "new", "to": "readings", "label": "pick one" }
      ] }
  ]
}
